        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"Perfume Demonstracao\",\r\n  \"marca\": \"Marca Teste\",\r\n  \"preco\": 149.9,\r\n  \"quantidadeEstoque\": 10,\r\n  \"categoriaId\": 1,\r\n  \"fornecedorId\": 1\r\n}",
