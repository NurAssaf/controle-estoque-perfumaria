    {
      "name": "Cadastrar produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Produto cadastrado com categoria e fornecedor\", function () {\r\n    pm.response.to.have.status(201);\r\n\r\n    const produto = pm.response.json();\r\n    pm.expect(produto.id).to.be.a(\"number\");\r\n    pm.expect(produto.categoria.id).to.eql(1);\r\n    pm.expect(produto.fornecedor.id).to.eql(1);\r\n\r\n    pm.collectionVariables.set(\"produtoId\", produto.id);\r\n});"
            ]
          }
        }
      ],
